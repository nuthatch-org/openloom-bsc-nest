# Stopgap nests for subgraphs the network does not serve (docs/subgraph-stopgap.md). One route per deployment.
subgraphs.nuthatch-indexer.com {
	request_body {
		max_size 32KB
	}
	# Per IP first, then the whole host: one heavy caller cannot crowd out the users of an app, and a
	# flood is bounced here before it reaches the two SQL permits of the nest.
	rate_limit {
		zone subgraphs_ip {
			key {remote_host}
			events 600
			window 10s
		}
		zone subgraphs_all {
			key static
			events 3000
			window 10s
		}
	}
	@preflight method OPTIONS
	handle @preflight {
		header Access-Control-Allow-Origin "*"
		header Access-Control-Allow-Methods "POST, OPTIONS"
		header Access-Control-Allow-Headers "content-type"
		header Access-Control-Max-Age "86400"
		respond 204
	}
	# A person opening the endpoint in a browser gets its page: status, playground, snippets.
	@page {
		method GET
		path_regexp dep ^/subgraphs/id/(Qm[1-9A-HJ-NP-Za-km-z]{44})$
	}
	redir @page https://nuthatch-indexer.com/subgraphs/{re.dep.1} 302
	# openloom-bsc, graph-support#53
	handle /subgraphs/id/QmXsbGm5Mbm9H5HWrt11uwWSf58MyaxjspF4TNYx166Xgz {
		header Access-Control-Allow-Origin "*"
		reverse_proxy 100.83.44.63:8311
	}
	handle {
		respond "Stopgap GraphQL for subgraphs the network does not serve: POST to /subgraphs/id/<deployment>. See https://github.com/nuthatch-org/nuthatch/blob/main/docs/subgraph-stopgap.md" 404
	}
}
