# Stopgap nests for subgraphs the network does not serve (docs/subgraph-stopgap.md). One route per deployment.
subgraphs.nuthatch-indexer.com {
	@preflight method OPTIONS
	handle @preflight {
		header Access-Control-Allow-Origin "*"
		header Access-Control-Allow-Methods "POST, OPTIONS"
		header Access-Control-Allow-Headers "content-type"
		header Access-Control-Max-Age "86400"
		respond 204
	}
	# A person opening the endpoint in a browser gets its page: status, playground, snippets.
	@page {
		method GET
		path_regexp dep ^/subgraphs/id/(Qm[1-9A-HJ-NP-Za-km-z]{44})$
	}
	redir @page https://nuthatch-indexer.com/subgraphs/{re.dep.1} 302
	# openloom-bsc, graph-support#53
	handle /subgraphs/id/QmXsbGm5Mbm9H5HWrt11uwWSf58MyaxjspF4TNYx166Xgz {
		header Access-Control-Allow-Origin "*"
		reverse_proxy 100.83.44.63:8311
	}
	handle {
		respond "Stopgap GraphQL for subgraphs the network does not serve: POST to /subgraphs/id/<deployment>. See https://github.com/nightswatchhq/nuthatch/blob/main/docs/subgraph-stopgap.md" 404
	}
}
